{
  "name": "opc-ai-gui-web",
  "version": "1.30.20",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start:real": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-real.ps1",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "preview:long": "bash scripts/start-preview.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "vitest": "^2.1.8"
  }
}

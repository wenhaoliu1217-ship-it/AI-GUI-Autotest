FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

ENV DEBIAN_FRONTEND=noninteractive
ENV PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000
RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "120";\nAcquire::https::Timeout "120";\n' > /etc/apt/apt.conf.d/80-retries
RUN apt-get update \
    && apt-get install -y --no-install-recommends iptables util-linux \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir playwright==1.49.1
RUN set -eu; \
    installed=0; \
    for attempt in 1 2 3 4 5; do \
        if python -m playwright install-deps chromium; then installed=1; break; fi; \
        apt-get update; \
    done; \
    test "$installed" = 1; \
    rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    installed=0; \
    for attempt in 1 2 3 4 5; do \
        if python -m playwright install chromium; then installed=1; break; fi; \
    done; \
    test "$installed" = 1
RUN mv /root/.cache/ms-playwright /ms-playwright \
    && chmod -R a+rX /ms-playwright
RUN useradd --create-home --uid 10001 runner

WORKDIR /app
COPY pyproject.toml requirements.txt ./
COPY src ./src
COPY container-entrypoint.sh /usr/local/bin/container-entrypoint
RUN pip install --no-cache-dir .
RUN chmod 0555 /usr/local/bin/container-entrypoint

ENV PYTHONUNBUFFERED=1
ENV HOME=/home/runner
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENTRYPOINT ["/usr/local/bin/container-entrypoint"]
CMD ["python", "-m", "gui_agent.execution.container_worker"]
